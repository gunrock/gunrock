#!/usr/bin/env bash
# rjsim <arch> -- <cmd...> runs a command on a CPU-emulated AMD GPU.
# Supported aliases: gfx942, gfx950, gfx1201, and gfx1250.
# A rocjitsu config path also works.
set -euo pipefail

if [[ $# -lt 1 ]]; then
  sed -n '2,3p' "$0" | sed 's/^# //'
  exit 2
fi

arch=$1
shift
[[ ${1:-} == -- ]] && shift
[[ $# -gt 0 ]] || { echo "rjsim: no command specified" >&2; exit 2; }

rocm-sdk init >/dev/null 2>&1 || true
root=$(rocm-sdk path --root)

case "$arch" in
  gfx942) config=gfx942_cdna3_kmd.json ;;
  gfx950) config=gfx950_mi355x_kmd.json ;;
  gfx1201) config=gfx1201_r9700.json ;;
  gfx1250) config=gfx1250_mi455x.json ;;
  *.json) config=$arch ;;
  *) echo "rjsim: unsupported architecture '$arch'" >&2; exit 2 ;;
esac

[[ $config == /* || -f $config ]] || config="$root/share/rocjitsu/configs/$config"
[[ -f $config ]] || { echo "rjsim: missing config '$config'" >&2; exit 2; }

export RJ_ARCH="$arch"
export ROCM_PATH="$root"
export HIP_PATH="$root"
export PATH="$root/bin:$PATH"
export LD_LIBRARY_PATH="$root/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$root/bin/mirage" run \
  --in-process \
  --config "$config" \
  --cpu-thread-budget "${RJ_THREADS:-2}" \
  -- "$@"
